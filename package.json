{
  "name": "occasus-theme",
  "displayName": "Occasus Theme",
  "description": "A VS Code theme crafted to bring the warm, vibrant hues of the sunset to your editor, turning every line of code into a golden-hour experience.",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.43.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "generate:theme": "tsc && node dist/main.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Occasus Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/occasus-color-theme.json"
      },
      {
        "label": "Occasus Theme Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/occasus-color-theme-soft.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
