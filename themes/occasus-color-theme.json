  "tokenColors": [
    {
      "name": "Warm ivory default",
      "scope": ["source", "text"],
      "settings": { "foreground": "#F3E7DB", "fontStyle": "" }
    },
    {
      "name": "Warm muted comments",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring.multi.python"],
      "settings": { "foreground": "#B5A39A", "fontStyle": "italic" }
    },
    {
      "name": "Violet keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control.at-rule.css"],
      "settings": { "foreground": "#C792FF", "fontStyle": "italic" }
    },
    {
      "name": "Warm operators",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"],
      "settings": { "foreground": "#E7BDA4", "fontStyle": "" }
    },
    {
      "name": "Gold strings and attribute values",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#FFD76D", "fontStyle": "" }
    },
    {
      "name": "Pink escapes and interpolation markers",
      "scope": ["constant.character.escape", "punctuation.definition.template-expression", "punctuation.section.embedded", "punctuation.definition.interpolation"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "" }
    },
    {
      "name": "Ivory interpolated expressions",
      "scope": ["meta.template.expression", "meta.embedded.line", "meta.interpolation"],
      "settings": { "foreground": "#F3E7DB", "fontStyle": "" }
    },
    {
      "name": "Orange numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "variable.other.constant", "support.constant"],
      "settings": { "foreground": "#FFAA66", "fontStyle": "" }
    },
    {
      "name": "Orange types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "support.type.primitive", "storage.type.primitive"],
      "settings": { "foreground": "#FFAA66", "fontStyle": "" }
    },
    {
      "name": "Pink functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "" }
    },
    {
      "name": "Ivory variables",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#F3E7DB", "fontStyle": "" }
    },
    {
      "name": "Peach parameters and properties",
      "scope": ["variable.parameter", "variable.other.property", "support.variable.property", "variable.object.property", "meta.object-literal.key"],
      "settings": { "foreground": "#E7BDA4", "fontStyle": "" }
    },
    {
      "name": "Violet self and this",
      "scope": ["variable.language"],
      "settings": { "foreground": "#C792FF", "fontStyle": "italic" }
    },
    {
      "name": "Violet decorators and annotations",
      "scope": ["entity.name.function.decorator", "entity.name.function.decorator.python", "meta.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#C792FF", "fontStyle": "" }
    },
    {
      "name": "Warm punctuation",
      "scope": ["punctuation.section", "punctuation.definition.parameters", "punctuation.definition.arguments", "punctuation.definition.list", "punctuation.definition.dictionary"],
      "settings": { "foreground": "#D5C2B4", "fontStyle": "" }
    },
    {
      "name": "Violet markup tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#C792FF", "fontStyle": "" }
    },
    {
      "name": "Muted tag brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#B5A39A", "fontStyle": "" }
    },
    {
      "name": "Pink HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "" }
    },
    {
      "name": "Pink CSS properties",
      "scope": ["support.type.property-name", "support.type.vendored.property-name", "meta.property-name.css", "variable.css"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "" }
    },
    {
      "name": "Violet CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css", "entity.name.tag.css"],
      "settings": { "foreground": "#C792FF", "fontStyle": "" }
    },
    {
      "name": "Gold CSS values",
      "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"],
      "settings": { "foreground": "#FFD76D", "fontStyle": "" }
    },
    {
      "name": "Orange CSS units",
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#FFAA66", "fontStyle": "" }
    },
    {
      "name": "Gold regular expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#FFD76D", "fontStyle": "" }
    },
    {
      "name": "Pink regular expression operators",
      "scope": ["keyword.operator.quantifier.regexp", "keyword.operator.or.regexp", "punctuation.definition.group.regexp", "punctuation.definition.character-class.regexp"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "" }
    },
    {
      "name": "Violet Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#C792FF", "fontStyle": "bold" }
    },
    {
      "name": "Pink Markdown emphasis",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "bold" }
    },
    {
      "name": "Peach Markdown italics",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#E7BDA4", "fontStyle": "italic" }
    },
    {
      "name": "Combined Markdown emphasis",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "bold italic" }
    },
    {
      "name": "Gold inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown punctuation.definition.markdown"],
      "settings": { "foreground": "#FFD76D", "fontStyle": "" }
    },
    {
      "name": "Muted Markdown quotations",
      "scope": ["markup.quote", "punctuation.definition.quote.markdown"],
      "settings": { "foreground": "#B5A39A", "fontStyle": "italic" }
    },
    {
      "name": "Pink Markdown links",
      "scope": ["string.other.link.title.markdown", "markup.underline.link.markdown", "constant.other.reference.link.markdown"],
      "settings": { "foreground": "#FF70B5", "fontStyle": "underline" }
    },
    {
      "name": "Orange list markers",
      "scope": ["punctuation.definition.list.begin.markdown", "punctuation.definition.list_item.markdown"],
      "settings": { "foreground": "#FFAA66", "fontStyle": "" }
    },
    {
      "name": "Muted strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#B5A39A", "fontStyle": "strikethrough" }
    },
    {
      "name": "Green additions",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#A8CD88", "fontStyle": "" }
    },
    {
      "name": "Rose deletions and invalid syntax",
      "scope": ["markup.deleted", "invalid"],
      "settings": { "foreground": "#FF6B7A", "fontStyle": "" }
    },
    {
      "name": "Orange changed lines",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#FFAA66", "fontStyle": "" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": { "foreground": "#C792FF", "italic": false },
    "class": { "foreground": "#FFAA66", "italic": false },
    "enum": { "foreground": "#FFAA66", "italic": false },
    "interface": { "foreground": "#FFAA66", "italic": false },
    "struct": { "foreground": "#FFAA66", "italic": false },
    "typeParameter": { "foreground": "#C792FF", "italic": false },
    "type": { "foreground": "#FFAA66", "italic": false },
    "parameter": { "foreground": "#E7BDA4", "italic": false },
    "variable": { "foreground": "#F3E7DB", "italic": false },
    "variable.readonly": { "foreground": "#FFAA66", "italic": false },
    "property": { "foreground": "#E7BDA4", "italic": false },
    "property.readonly": { "foreground": "#FFAA66", "italic": false },
    "enumMember": { "foreground": "#FFAA66", "italic": false },
    "decorator": { "foreground": "#C792FF", "italic": false },
    "event": { "foreground": "#FF70B5", "italic": false },
    "function": { "foreground": "#FF70B5", "italic": false },
    "method": { "foreground": "#FF70B5", "italic": false },
    "macro": { "foreground": "#C792FF", "italic": false },
    "label": { "foreground": "#FF70B5", "italic": false },
    "comment": { "foreground": "#B5A39A", "italic": true },
    "string": { "foreground": "#FFD76D", "italic": false },
    "keyword": { "foreground": "#C792FF", "italic": true },
    "number": { "foreground": "#FFAA66", "italic": false },
    "regexp": { "foreground": "#FFD76D", "italic": false },
    "operator": { "foreground": "#E7BDA4", "italic": false },
    "modifier": { "foreground": "#C792FF", "italic": true },
  }
}
